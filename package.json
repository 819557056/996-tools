{
  "name": "mytools-vue",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "create-tool": "node scripts/create-tool.js",
    "test:crypto": "node --experimental-strip-types --test tests/crypto-material.test.mjs tests/crypto-workflows.test.mjs tests/sm3-stream.test.mjs",
    "test:pki": "node --test tests/local-pki.test.mjs tests/pki-key-import.test.mjs",
    "test:pki:interop": "node --test tests/pki-sm2-interop.test.mjs",
    "test:pki:browser": "node tests/local-pki-browser.mjs",
    "test:pdf": "node --test tests/local-pdf.test.mjs",
    "test:revocation": "node --test tests/offline-revocation.test.mjs",
    "test:pdf:browser": "node tests/local-pdf-browser.mjs",
    "test:browser": "node tests/local-tools-browser.mjs"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@iarna/toml": "^2.2.5",
    "@vueuse/core": "^11.3.0",
    "asn1js": "^3.0.7",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "echarts": "^6.0.0",
    "fast-gbk": "^0.0.1",
    "fast-xml-parser": "^5.3.2",
    "ini": "^6.0.0",
    "jmespath": "^0.16.0",
    "js-yaml": "^4.1.1",
    "json5": "^2.2.3",
    "jsonpath-plus": "^10.3.0",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.1.5",
    "nanoid-dictionary": "^4.3.0",
    "node-forge": "^1.3.2",
    "papaparse": "^5.5.3",
    "pinia": "^2.2.8",
    "pkijs": "^3.3.3",
    "properties-reader": "^2.3.0",
    "qr-code-styling": "^1.9.1",
    "sm-crypto": "^0.3.13",
    "ulid": "^3.0.1",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jszip": "^3.4.1",
    "@types/nanoid-dictionary": "^4.2.3",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "@types/papaparse": "^5.5.0",
    "@types/sm-crypto": "^0.3.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.31.0",
    "pdf-lib": "1.17.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "terser": "^5.44.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-compression": "^0.5.1",
    "vue-i18n": "^11.2.1",
    "vue-tsc": "^2.1.10"
